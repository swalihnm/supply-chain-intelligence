# Data never goes in git. SCI_DATA_DIR should point outside OneDrive anyway,
# but keep a local ./data escape hatch ignored too.
data/
*.duckdb
*.duckdb.wal
*.parquet
*.csv
*.zip

# Secrets
.env
.env.local
*.json.secret

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Notebook outputs are noise in diffs; strip before committing.
notebooks/**/*.html

# OS / editor
Thumbs.db
.DS_Store
.vscode/
.idea/

# Staged serving artifacts for the Docker build context. Derived data - 23 MB -
# regenerated by scripts/stage_deploy.py, so it does not belong in git.
deploy/data/
