# Copy to .env and fill in. .env is gitignored.

# Where bulk data lives. Keep this OUTSIDE OneDrive: the warehouse and parquet
# feature tables run to several GB and OneDrive will try to sync every rewrite.
SCI_DATA_DIR=C:/sci-data

# Path to the M5 competition download. Either the raw zip you got from Kaggle,
# or a folder already containing calendar.csv / sell_prices.csv /
# sales_train_evaluation.csv. Leave blank until you have it.
SCI_M5_SOURCE=

# FRED (macro covariates). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Optional. The macro ingest is skipped when this is empty.
FRED_API_KEY=

# Open-Meteo needs no key.
